{
  "name": "geopress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GIS 数据加工与静态目录发布桌面工具",
  "author": "GeoPress",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts && .venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "python:format": ".venv/bin/python -m ruff format python scripts tests",
    "python:check": ".venv/bin/python -m ruff check python scripts tests && .venv/bin/python -m ruff format --check python scripts tests"
  },
  "dependencies": {
    "cesium": "^1.139.0",
    "lucide-vue-next": "^0.468.0",
    "naive-ui": "^2.45.3",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "neostandard": "^0.13.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "com.geopress.desktop",
    "productName": "GeoPress",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python"
      },
      {
        "from": "resources/engines",
        "to": "engines"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/app.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/app.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "resources/icons/icon-512.png"
    },
    "beforePack": "scripts/check-package.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
